<%- include('header.ejs') %>

<section id="artigos" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-5xl">
        <div class="text-center mb-16">
            <span class="section-label">Pesquisa e Conhecimento</span>
            <h2 class="section-title">Artigos Científicos</h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto mt-4">Publicações e produções acadêmicas desenvolvidas pelo NuAR.</p>
        </div>

        <div class="space-y-6">
            <% artigos.forEach(artigo => { %>
            <article class="artigo-card group">
                <div class="flex flex-col md:flex-row md:items-start gap-5">
                    <div class="artigo-icon-wrapper flex-shrink-0">
                        <svg class="h-6 w-6 text-[#C46ED8]" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="flex-grow">
                        <h2 class="text-xl font-bold text-[#3B2C5B] mb-2 leading-tight group-hover:text-[#C46ED8] transition-colors">
                            <%= artigo.titulo %>
                        </h2>
                        <% if (artigo.resumo) { %>
                            <p class="text-gray-600 leading-relaxed mb-4 text-base"><%= artigo.resumo %></p>
                        <% } %>
                        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
                            <% if (artigo.data_publicacao) { %>
                                <span class="inline-flex items-center gap-1.5">
                                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
                                    <%= new Date(artigo.data_publicacao).toLocaleDateString('pt-BR') %>
                                </span>
                            <% } %>
                            <% if (artigo.projeto_titulo) { %>
                                <span class="inline-flex items-center gap-1.5 bg-purple-50 text-[#6B4F9E] px-3 py-1 rounded-full font-medium text-xs">
                                    <%= artigo.projeto_titulo %>
                                </span>
                            <% } %>
                        </div>
                        <% if (artigo.link_externo) { %>
                        <div class="mt-4">
                            <a href="<%= artigo.link_externo %>" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-2 text-sm font-semibold text-[#C46ED8] hover:text-[#8C40B8] transition-colors">
                                Acessar artigo completo
                                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </a>
                        </div>
                        <% } %>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (!artigos || artigos.length === 0) { %>
            <div class="text-center py-20">
                <p class="text-gray-400 text-lg">Nenhum artigo publicado ainda.</p>
            </div>
        <% } %>
    </div>
</section>

<%- include('footer.ejs') %>
