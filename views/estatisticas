const fs = require('fs');
const path = require('path');
const geoip = require('geoip-lite');


const DIR_DADOS = path.join(__dirname, '..', 'data');
const ARQUIVO_ACESSOS = path.join(DIR_DADOS, 'acessos.jsonl');
const ARQUIVO_CLIQUES = path.join(DIR_DADOS, 'cliques.jsonl');

if (!fs.existsSync(DIR_DADOS)) {
    fs.mkdirSync(DIR_DADOS, { recursive: true });
}

const PREFIXOS_IGNORADOS = ['/admin', '/uploads', '/favicon.ico', '/robots.txt'];
const EXTENSOES_IGNORADAS = /\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|map)$/i;

function obterIp(req) {
    const encaminhado = req.headers['x-forwarded-for'];
    if (encaminhado) return encaminhado.split(',')[0].trim();
    return req.socket?.remoteAddress || null;
}

function anexarLinha(arquivo, objeto) {
    fs.appendFile(arquivo, JSON.stringify(objeto) + '\n', err => {
        if (err) console.error(`Erro ao gravar log (${arquivo}):`, err);
    });
}

function registrarAcesso(req, res, next) {
    next();

    if (req.method !== 'GET') return;
    if (PREFIXOS_IGNORADOS.some(prefixo => req.path.startsWith(prefixo))) return;
    if (EXTENSOES_IGNORADAS.test(req.path)) return;

    const ip = obterIp(req);
    const geo = ip ? geoip.lookup(ip) : null;

    anexarLinha(ARQUIVO_ACESSOS, {
        rota: req.path,
        pais: geo?.country || null,
        regiao: geo?.region || null,
        cidade: geo?.city || null,
        referrer: req.headers['referer'] || null,
        dataHora: new Date().toISOString()
    });
}

function registrarClique(req, { linkId, titulo }) {
    const ip = obterIp(req);
    const geo = ip ? geoip.lookup(ip) : null;

    anexarLinha(ARQUIVO_CLIQUES, {
        linkId,
        titulo,
        pais: geo?.country || null,
        cidade: geo?.city || null,
        dataHora: new Date().toISOString()
    });
}

function lerLinhas(arquivo) {
    if (!fs.existsSync(arquivo)) return [];
    return fs.readFileSync(arquivo, 'utf-8')
        .split('\n')
        .filter(Boolean)
        .map(linha => {
            try {
                return JSON.parse(linha);
            } catch {
                return null;
            }
        })
        .filter(Boolean);
}

function contarPorChave(lista, chave, limite = 10) {
    const contagem = {};
    lista.forEach(item => {
        const valor = item[chave] || 'Desconhecido';
        contagem[valor] = (contagem[valor] || 0) + 1;
    });
    return Object.entries(contagem)
        .map(([nome, total]) => ({ nome, total }))
        .sort((a, b) => b.total - a.total)
        .slice(0, limite);
}

function obterEstatisticas() {
    const acessos = lerLinhas(ARQUIVO_ACESSOS);
    const cliques = lerLinhas(ARQUIVO_CLIQUES);
    
    const hoje = new Date();
    const dias = [];
    for (let i = 29; i >= 0; i--) {
        const d = new Date(hoje);
        d.setDate(d.getDate() - i);
        dias.push(d.toISOString().slice(0, 10));
    }
    const contagemPorDia = {};
    acessos.forEach(a => {
        const dia = (a.dataHora || '').slice(0, 10);
        contagemPorDia[dia] = (contagemPorDia[dia] || 0) + 1;
    });
    const acessosPorDia = dias.map(dia => ({ dia, total: contagemPorDia[dia] || 0 }));

    // Links mais clicados (agrupando por título)
    const contagemLinks = {};
    cliques.forEach(c => {
        const titulo = c.titulo || `Link #${c.linkId}`;
        contagemLinks[titulo] = (contagemLinks[titulo] || 0) + 1;
    });
    const linksMaisClicados = Object.entries(contagemLinks)
        .map(([titulo, total]) => ({ titulo, total }))
        .sort((a, b) => b.total - a.total)
        .slice(0, 10);

    return {
        totalAcessos: acessos.length,
        totalCliques: cliques.length,
        acessosPorDia,
        acessosPorPais: contarPorChave(acessos, 'pais'),
        acessosPorRota: contarPorChave(acessos, 'rota'),
        linksMaisClicados
    };
}

module.exports = { registrarAcesso, registrarClique, obterEstatisticas };
