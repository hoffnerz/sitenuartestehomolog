<!DOCTYPE html>
<html lang="pt-br" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NuAR - Núcleo de Animação e Roteiro do IFMS</title>
    <meta name="description" content="Site oficial do NuAR - Núcleo de Animação e Roteiro do IFMS. Conheça nossos projetos, produções e equipe.">
    <meta name="keywords" content="NuAR, IFMS, Núcleo de Animação e Roteiro, animação, roteiro, projetos, tecnologia, educação, Campo Grande, MS, VOX, CTRL+femme, 3DSTORY">
    <link rel="icon" href="/Imagens/logonuar.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="leading-relaxed antialiased">

    <header id="mainHeader" class="nuar-header sticky top-0 z-50">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="flex items-center justify-between h-16 md:h-20">

                <a href="/" class="flex items-center gap-3 group flex-shrink-0" aria-label="Página inicial do NuAR">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIqgzSWlM1EQ4CZ8vYqYBVAtYD0yfehFwAfg&s"
                         alt="Logo NuAR" class="h-10 w-auto rounded-lg">
                    <div>
                        <span class="block text-xl font-black text-white tracking-tight leading-none">NuAR</span>
                        <span class="block text-xs text-purple-200 font-medium leading-none mt-0.5 hidden sm:block">Núcleo de Animação e Roteiro</span>
                    </div>
                </a>

                <nav class="hidden lg:flex items-center gap-1" aria-label="Navegação principal">
                    <a href="/" class="nav-link-desktop">Início</a>
                    <a href="/projetos" class="nav-link-desktop">Projetos</a>
                    <a href="/noticias" class="nav-link-desktop">Notícias</a>
                    <a href="/producoes" class="nav-link-desktop">Produções</a>
                    <a href="/artigos" class="nav-link-desktop">Artigos</a>
                    <a href="/feiras" class="nav-link-desktop">Feiras</a>
                    <a href="/editais" class="nav-link-desktop">Editais</a>
                    <a href="/equipe" class="nav-link-desktop">Equipe</a>
                    <a href="/links" class="nav-link-desktop nav-link-vox">
                        <span class="inline-flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-[#C46ED8] animate-pulse"></span>
                            Edições VOX
                        </span>
                    </a>
                </nav>

                <!-- Menu de Acessibilidade Global -->
                <div class="accessibility-menu hidden lg:flex items-center">
                    <button id="accessibilityToggleBtn" 
                            class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg hover:bg-white/10 transition-colors" 
                            aria-label="Abrir menu de acessibilidade" 
                            aria-expanded="false"
                            aria-controls="accessibilityPanel">
                        <svg class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                        </svg>
                    </button>
                    <div id="accessibilityPanel" 
                         class="accessibility-panel hidden absolute top-full right-0 mt-2 bg-white rounded-lg shadow-lg border border-gray-200 p-4 min-w-max z-50" 
                         role="dialog" 
                         aria-modal="true" 
                         aria-labelledby="accessibilityTitle">
                        <h3 id="accessibilityTitle" class="text-sm font-bold text-gray-900 mb-3">Acessibilidade</h3>
                        <div class="space-y-3">
                            <div>
                                <p class="text-xs font-semibold text-gray-600 mb-2 uppercase tracking-wider">Tamanho da Fonte</p>
                                <div class="flex gap-1.5">
                                    <button class="btn-accessibility-header" data-action="decrease" aria-label="Diminuir fonte">A−</button>
                                    <button class="btn-accessibility-header" data-action="reset" aria-label="Restaurar fonte">A</button>
                                    <button class="btn-accessibility-header" data-action="increase" aria-label="Aumentar fonte">A+</button>
                                </div>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-gray-600 mb-2 uppercase tracking-wider">Contraste</p>
                                <button class="btn-contrast-header w-full" aria-label="Alternar alto contraste">
                                    Alto Contraste
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <!-- Menu de Acessibilidade Mobile -->
                    <div class="accessibility-menu lg:hidden">
                        <button id="accessibilityToggleBtnMobile" 
                                class="flex items-center justify-center w-10 h-10 rounded-lg hover:bg-white/10 transition-colors" 
                                aria-label="Abrir menu de acessibilidade" 
                                aria-expanded="false"
                                aria-controls="accessibilityPanelMobile">
                            <svg class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                            </svg>
                        </button>
                    </div>

                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                        <div class="profile-menu">
                            <button class="flex items-center gap-2 text-white hover:text-purple-200 transition-colors" aria-label="Menu do administrador">
                                <img src="<%= userPhoto %>" alt="Foto do Perfil" class="h-9 w-9 rounded-full border-2 border-purple-300 object-cover">
                                <span class="hidden md:block text-sm font-medium">Admin</span>
                            </button>
                            <div id="profileDropdown" class="profile-menu-content">
                                <a href="/admin/logout">Sair</a>
                            </div>
                        </div>
                    <% } else { %>
                        <button id="headerMenuBtn"
                                class="lg:hidden flex flex-col justify-center items-center w-10 h-10 rounded-lg hover:bg-white/10 transition-colors gap-1.5 p-2"
                                aria-label="Abrir menu de navegação"
                                aria-expanded="false">
                            <span class="hamburger-line"></span>
                            <span class="hamburger-line"></span>
                            <span class="hamburger-line"></span>
                        </button>
                    <% } %>
                </div>

            </div>
        </div>
    </header>

    <div id="sideMenuOverlay" class="menu-overlay" role="dialog" aria-modal="true" aria-label="Menu de navegação">
        <div class="side-menu" id="sideMenuPanel">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-3">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIqgzSWlM1EQ4CZ8vYqYBVAtYD0yfehFwAfg&s"
                         alt="Logo NuAR" class="h-8 w-auto rounded">
                    <span class="text-white font-bold text-lg">NuAR</span>
                </div>
                <button class="close-menu-btn" aria-label="Fechar menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <nav class="flex flex-col gap-1 mb-6" aria-label="Navegação mobile">
                <a href="/" class="nav-link-side">Início</a>
                <a href="/projetos" class="nav-link-side">Projetos</a>
                <a href="/noticias" class="nav-link-side">Notícias</a>
                <a href="/producoes" class="nav-link-side">Produções</a>
                <a href="/artigos" class="nav-link-side">Artigos</a>
                <a href="/feiras" class="nav-link-side">Feiras</a>
                <a href="/editais" class="nav-link-side">Editais</a>
                <a href="/equipe" class="nav-link-side">Equipe</a>
                <a href="/links" class="nav-link-side nav-link-side-vox">
                    Edições VOX
                    <span class="ml-auto text-xs bg-[#C46ED8] text-white px-2 py-0.5 rounded-full font-semibold">Jornal</span>
                </a>
            </nav>

            <!-- Acessibilidade Mobile -->
            <div id="accessibilityPanelMobile" class="border-t border-white/10 pt-4">
                <p class="text-purple-200 text-xs font-semibold mb-3 uppercase tracking-wider">Acessibilidade</p>
                <div class="space-y-3">
                    <div>
                        <p class="text-purple-200 text-xs font-semibold mb-2 uppercase tracking-wider">Tamanho da Fonte</p>
                        <div class="flex gap-1.5">
                            <button class="btn-accessibility-mobile" data-action="decrease" aria-label="Diminuir fonte">A−</button>
                            <button class="btn-accessibility-mobile" data-action="reset" aria-label="Restaurar fonte">A</button>
                            <button class="btn-accessibility-mobile" data-action="increase" aria-label="Aumentar fonte">A+</button>
                        </div>
                    </div>
                    <div>
                        <p class="text-purple-200 text-xs font-semibold mb-2 uppercase tracking-wider">Contraste</p>
                        <button class="btn-contrast-mobile w-full" aria-label="Alternar alto contraste">
                            Alto Contraste
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

