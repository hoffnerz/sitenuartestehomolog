<%- include('header.ejs') %>

<section id="noticias" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-5xl">
        <div class="text-center mb-16">
            <span class="section-label">Fique por dentro</span>
            <h2 class="section-title">Últimas Notícias</h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto mt-4">Acompanhe os destaques e novidades do NuAR.</p>
        </div>

        <div class="space-y-6">
            <% noticias.forEach((noticia, index) => { %>
            <article class="news-card group animate-on-scroll">
                <div class="flex flex-col md:flex-row md:items-start gap-6">
                    <div class="flex-shrink-0 hidden md:flex flex-col items-center">
                        <div class="news-date-block">
                            <span class="block text-2xl font-black text-[#3B2C5B] leading-none">
                                <%= new Date(noticia.data_publicacao).getDate().toString().padStart(2,'0') %>
                            </span>
                            <span class="block text-xs font-semibold text-[#C46ED8] uppercase tracking-wider">
                                <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR', { month: 'short' }).replace('.','') %>
                            </span>
                            <span class="block text-xs text-gray-400 font-medium">
                                <%= new Date(noticia.data_publicacao).getFullYear() %>
                            </span>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-center gap-3 mb-3">
                            <% if (index === 0) { %>
                                <span class="news-badge-destaque">Destaque</span>
                            <% } %>
                            <time class="text-sm text-gray-400 md:hidden">
                                <%= new Date(noticia.data_publicacao).toLocaleDateString('pt-BR') %>
                            </time>
                        </div>
                        <h2 class="text-xl md:text-2xl font-bold text-[#3B2C5B] mb-3 leading-tight group-hover:text-[#C46ED8] transition-colors">
                            <%= noticia.titulo %>
                        </h2>
                        <p class="text-gray-600 leading-relaxed mb-4">
                            <%= noticia.conteudo.length > 280 ? noticia.conteudo.slice(0, 280) + '...' : noticia.conteudo %>
                        </p>
                        <% if (noticia.link_externo) { %>
                        <a href="<%= noticia.link_externo %>" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-2 text-sm font-semibold text-[#C46ED8] hover:text-[#8C40B8] transition-colors">
                            Leia a matéria completa
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                        <% } %>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (!noticias || noticias.length === 0) { %>
            <div class="text-center py-20">
                <p class="text-gray-400 text-lg">Nenhuma notícia publicada ainda.</p>
            </div>
        <% } %>
    </div>
</section>

<%- include('footer.ejs') %>
