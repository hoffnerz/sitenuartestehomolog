<%- include('../header.ejs') %>

<section class="bg-white py-24 md:py-40 px-4 animate-on-scroll min-h-screen">
    <div class="container mx-auto max-w-7xl flex flex-col md:flex-row gap-10">
        <%- include('../_admin_sidebar.ejs') %>
        <main class="w-full md:w-3/4 bg-[#f0f0f0] p-10 rounded-3xl shadow-lg">
            <h2 class="text-4xl font-bold text-[#3B2C5B] mb-8">Painel de Administração - Artigos</h2>

            <% if (typeof sucesso !== 'undefined') { %>
                <div class="bg-green-200 text-green-800 p-4 rounded-md mb-6">
                    <p>Item adicionado/deletado/alterado com sucesso!</p>
                </div>
            <% } %>

            <div id="artigos-form" class="space-y-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-3xl font-bold text-[#3B2C5B]">Artigos</h3>
                    <button id="btn-adicionar-artigo" class="bg-[#C46ED8] text-white px-4 py-2 rounded hover:bg-[#8C40B8] transition-colors">Adicionar Artigo</button>
                </div>
                <div id="form-artigos-container" class="hidden mt-8 p-6 bg-white rounded-lg shadow">
                    <h4 id="form-title-artigo" class="text-2xl font-bold text-[#3B2C5B] mb-4">Adicionar Novo Artigo</h4>
                    <form id="form-artigo" action="/admin/adicionar-artigo" method="POST" class="space-y-6">
                        <input type="hidden" name="id" id="artigo-id-input">
                        <input type="text" name="titulo" id="artigo-titulo-input" placeholder="Título" required class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <textarea name="resumo" id="artigo-resumo-input" placeholder="Resumo" rows="4" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors"></textarea>
                        <input type="text" name="link_externo" id="artigo-link_externo-input" placeholder="Link Externo" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="date" name="data_publicacao" id="artigo-data_publicacao-input" placeholder="Data de Publicação" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <select name="projeto_id" id="artigo-projeto_id-input" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                            <option value="">-- Selecione um Projeto --</option>
                            <% projetos.forEach(item => { %>
                                <option value="<%= item.id %>"><%= item.titulo %></option>
                            <% }) %>
                        </select>
                        <button type="submit" class="btn-roxo">Salvar</button>
                    </form>
                </div>
                <div class="mt-8">
                    <h4 class="text-2xl font-bold text-[#3B2C5B] mb-4">Artigos Existentes</h4>
                    <ul class="space-y-4">
                        <% artigos.forEach(item => { %>
                        <li class="bg-white p-4 rounded-lg shadow flex items-center justify-between">
                            <div><h5 class="font-bold text-[#3B2C5B]"><%= item.titulo %></h5></div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick='preencherFormArtigo(<%= JSON.stringify(item) %>)' class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">Alterar</button>
                                <form action="/admin/deletar-artigo/<%= item.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este item?');">
                                    <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-700 transition-colors">Deletar</button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </main>
    </div>
</section>

<script>
    function preencherFormArtigo(item) {
        document.getElementById('form-artigos-container').classList.remove('hidden');
        document.getElementById('form-title-artigo').innerText = 'Alterar Artigo';
        document.getElementById('form-artigo').action = '/admin/alterar-artigo/' + item.id;
        document.getElementById('artigo-id-input').value = item.id;
        document.getElementById('artigo-titulo-input').value = item.titulo;
        document.getElementById('artigo-resumo-input').value = item.resumo;
        document.getElementById('artigo-link_externo-input').value = item.link_externo;
        document.getElementById('artigo-data_publicacao-input').value = item.data_publicacao ? new Date(item.data_publicacao).toISOString().split('T')[0] : '';
        document.getElementById('artigo-projeto_id-input').value = item.projeto_id;
    }
    document.getElementById('btn-adicionar-artigo').addEventListener('click', function() {
        document.getElementById('form-artigos-container').classList.remove('hidden');
        document.getElementById('form-title-artigo').innerText = 'Adicionar Novo Artigo';
        document.getElementById('form-artigo').action = '/admin/adicionar-artigo';
        document.getElementById('form-artigo').reset();
    });
</script>
<%- include('../footer.ejs') %>