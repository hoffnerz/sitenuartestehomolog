<%- include('../header.ejs') %>
<link rel="stylesheet" href="/admin.css">

<section class="admin-page animate-on-scroll">
    <div class="admin-shell">

        <div class="admin-topbar">
            <span class="admin-topbar__title">Painel NuAR</span>
            <button type="button" id="adminSidebarOpenBtn" class="admin-topbar__toggle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                Menu
            </button>
        </div>

        <%- include('../_admin_sidebar.ejs') %>

        <main class="admin-main">
            <div class="admin-card">
                <div class="admin-page-header">
                    <div>
                        <span class="admin-page-header__eyebrow">Painel de administração</span>
                        <h2 class="admin-page-header__title">Equipe</h2>
                        <p class="admin-page-header__count"><%= equipe.length %> membro<%= equipe.length === 1 ? '' : 's' %> cadastrado<%= equipe.length === 1 ? '' : 's' %></p>
                    </div>
                    <button id="btn-adicionar-equipe" class="admin-btn admin-btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Membro
                    </button>
                </div>

                <% if (typeof sucesso !== 'undefined' && sucesso) {
                    let msg = 'Alteração realizada com sucesso!';
                    if (sucesso === 'true') msg = 'Membro adicionado com sucesso!';
                    else if (sucesso === 'alterado') msg = 'Membro atualizado com sucesso!';
                    else if (sucesso === 'deletado') msg = 'Membro removido com sucesso!';
                %>
                    <div class="admin-alert admin-alert--success">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                        </svg>
                        <span><%= msg %></span>
                    </div>
                <% } %>

                <% if (typeof erro_upload !== 'undefined' && erro_upload) { %>
                    <div class="admin-alert admin-alert--error">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                        </svg>
                        <span>Não foi possível enviar a foto. Verifique se o arquivo é JPG, PNG, WEBP ou GIF e se tem até 5MB.</span>
                    </div>
                <% } %>

                <div id="form-equipe-container" class="admin-form-panel hidden">
                    <h4 id="form-title-equipe" class="admin-form-panel__title">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Novo Membro
                    </h4>
                    <form id="form-equipe" action="/admin/adicionar-equipe" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="id" id="equipe-id-input">
                        <div class="admin-form-grid">
                            <div class="admin-field">
                                <label for="equipe-nome-input">Nome</label>
                                <input type="text" name="nome" id="equipe-nome-input" placeholder="Nome completo" required class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="equipe-funcao-input">Função</label>
                                <input type="text" name="funcao" id="equipe-funcao-input" placeholder="Ex: Coordenador(a), Bolsista" class="admin-input">
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="equipe-descricao-input">Descrição</label>
                                <textarea name="descricao" id="equipe-descricao-input" placeholder="Breve descrição sobre o membro" rows="4" class="admin-textarea"></textarea>
                            </div>
                            <div class="admin-field admin-field--full">
                                <label>Foto do membro</label>
                                <div class="admin-upload">
                                    <div class="admin-upload__row">
                                        <img id="equipe-foto-preview" class="admin-upload__preview admin-upload__preview--empty" style="display:none;" alt="Pré-visualização">
                                        <div id="equipe-foto-preview-wrap" class="admin-upload__preview admin-upload__preview--empty" style="display:flex;">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                                        </div>
                                        <div id="equipe-foto-dropzone" class="admin-upload__dropzone">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                                            <span><strong>Clique para enviar</strong> ou arraste uma foto aqui</span>
                                        </div>
                                    </div>
                                    <span id="equipe-foto-filename" class="admin-upload__filename"></span>
                                    <input type="file" name="foto_arquivo" id="equipe-foto-arquivo" accept="image/*" class="hidden">
                                    <button type="button" id="equipe-foto-toggle-url" class="admin-upload__toggle-url">Ou usar uma URL de foto já existente</button>
                                    <div id="equipe-foto-url-wrap" class="admin-upload__url-field">
                                        <input type="text" name="foto_url" id="equipe-foto_url-input" placeholder="https://..." class="admin-input">
                                    </div>
                                </div>
                            </div>
                            <div class="admin-field">
                                <label for="equipe-lattes_url-input">URL do Lattes</label>
                                <input type="text" name="lattes_url" id="equipe-lattes_url-input" placeholder="https://lattes.cnpq.br/..." class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="equipe-email-input">Email</label>
                                <input type="text" name="email" id="equipe-email-input" placeholder="email@ifms.edu.br" class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="equipe-senha-input">Senha</label>
                                <input type="password" name="senha" id="equipe-senha-input" placeholder="Deixe em branco para não alterar" class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="equipe-permissao-input">Permissão</label>
                                <select name="permissao" id="equipe-permissao-input" class="admin-select">
                                    <option value="membro">Membro</option>
                                    <option value="admin">Administrador (acesso ao painel)</option>
                                </select>
                                <span class="admin-hint">"Administrador" permite fazer login neste painel.</span>
                            </div>
                        </div>
                        <div class="admin-form-actions">
                            <button type="submit" class="admin-btn admin-btn--primary">Salvar</button>
                        </div>
                    </form>
                </div>

                <div class="admin-section-heading">
                    <h4 class="admin-section-heading__title">Membros existentes</h4>
                </div>

                <% if (equipe.length > 0) { %>
                    <div class="admin-search">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                        <input type="text" id="equipe-search-input" placeholder="Buscar por nome ou função...">
                    </div>
                <% } %>

                <% if (equipe.length === 0) { %>
                    <div class="admin-empty-state">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m5-3a4 4 0 100-8 4 4 0 000 8z"/>
                        </svg>
                        <p>Nenhum membro cadastrado ainda.</p>
                    </div>
                <% } else { %>
                    <ul class="admin-item-list">
                        <% equipe.forEach(item => { %>
                        <li class="admin-item-card" data-search="<%= item.nome %> <%= item.funcao %>">
                            <div class="admin-item-card__main">
                                <% if (item.foto_url) { %>
                                    <img src="<%= item.foto_url %>" alt="" class="admin-item-card__avatar">
                                <% } else { %>
                                    <div class="admin-item-card__avatar admin-item-card__avatar--fallback"><%= item.nome ? item.nome.charAt(0).toUpperCase() : '?' %></div>
                                <% } %>
                                <div class="admin-item-card__body">
                                    <h5 class="admin-item-card__title"><%= item.nome %></h5>
                                    <div class="admin-item-card__meta">
                                        <% if (item.funcao) { %>
                                            <span class="admin-badge admin-badge--accent"><%= item.funcao %></span>
                                        <% } %>
                                        <% if (item.permissao === 'admin') { %>
                                            <span class="admin-badge admin-badge--admin">Admin</span>
                                        <% } %>
                                        <% if (item.email) { %>
                                            <span><%= item.email %></span>
                                        <% } %>
                                        <% if (item.lattes_url) { %>
                                            <a href="<%= item.lattes_url %>" target="_blank" rel="noopener">Lattes →</a>
                                        <% } %>
                                    </div>
                                    <% if (item.modificado_em) { %>
                                        <span class="admin-item-card__updated">Atualizado em <%= new Date(item.modificado_em).toLocaleDateString('pt-BR') %><% if (item.modificado_por) { %> por <%= item.modificado_por %><% } %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="admin-item-card__actions">
                                <button type="button" onclick='preencherFormEquipe(<%- JSON.stringify(item) %>)' class="admin-btn admin-btn--edit admin-btn--sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
                                    Alterar
                                </button>
                                <form action="/admin/deletar-equipe/<%= item.id %>" method="POST" data-confirm="Tem certeza que deseja deletar &quot;<%= item.nome %>&quot; da equipe?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                                        Deletar
                                    </button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                    <p id="equipe-search-no-results" class="admin-search__no-results">Nenhum membro encontrado para essa busca.</p>
                <% } %>
            </div>
        </main>
    </div>
</section>

<script src="/admin.js"></script>
<script>
    const fotoEquipeWidget = window.setupImageUpload({
        dropzone: 'equipe-foto-dropzone',
        fileInput: 'equipe-foto-arquivo',
        preview: 'equipe-foto-preview',
        previewWrap: 'equipe-foto-preview-wrap',
        filename: 'equipe-foto-filename',
        urlFieldWrap: 'equipe-foto-url-wrap',
        urlInput: 'equipe-foto_url-input',
        toggleUrlBtn: 'equipe-foto-toggle-url'
    });

    window.setupListSearch({
        input: 'equipe-search-input',
        cardSelector: '.admin-item-list .admin-item-card',
        noResults: 'equipe-search-no-results'
    });

    function preencherFormEquipe(item) {
        document.getElementById('form-equipe-container').classList.remove('hidden');
        document.getElementById('form-title-equipe').innerText = 'Alterar Membro';
        document.getElementById('form-equipe').action = '/admin/alterar-equipe/' + item.id;
        document.getElementById('equipe-id-input').value = item.id;
        document.getElementById('equipe-nome-input').value = item.nome;
        document.getElementById('equipe-funcao-input').value = item.funcao;
        document.getElementById('equipe-descricao-input').value = item.descricao;
        if (fotoEquipeWidget) fotoEquipeWidget.reset(item.foto_url);
        document.getElementById('equipe-lattes_url-input').value = item.lattes_url;
        document.getElementById('equipe-email-input').value = item.email;
        document.getElementById('equipe-senha-input').value = '';
        document.getElementById('equipe-permissao-input').value = item.permissao;
        document.getElementById('form-equipe-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    document.getElementById('btn-adicionar-equipe').addEventListener('click', function() {
        document.getElementById('form-equipe-container').classList.remove('hidden');
        document.getElementById('form-title-equipe').innerText = 'Adicionar Novo Membro';
        document.getElementById('form-equipe').action = '/admin/adicionar-equipe';
        document.getElementById('form-equipe').reset();
        if (fotoEquipeWidget) fotoEquipeWidget.reset('');
    });
</script>
<%- include('../footer.ejs') %>
