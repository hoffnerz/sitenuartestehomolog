<%- include('../header.ejs') %>

<section class="bg-white py-24 md:py-40 px-4 animate-on-scroll min-h-screen">
    <div class="container mx-auto max-w-7xl flex flex-col md:flex-row gap-10">
        <%- include('../_admin_sidebar.ejs') %>
        <main class="w-full md:w-3/4 bg-[#f0f0f0] p-10 rounded-3xl shadow-lg">
            <h2 class="text-4xl font-bold text-[#3B2C5B] mb-8">Painel de Administração - Equipe</h2>

            <% if (typeof sucesso !== 'undefined') { %>
                <div class="bg-green-200 text-green-800 p-4 rounded-md mb-6">
                    <p>Item adicionado/deletado/alterado com sucesso!</p>
                </div>
            <% } %>

            <div id="equipe-form" class="space-y-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-3xl font-bold text-[#3B2C5B]">Equipe</h3>
                    <button id="btn-adicionar-equipe" class="bg-[#C46ED8] text-white px-4 py-2 rounded hover:bg-[#8C40B8] transition-colors">Adicionar Membro</button>
                </div>
                <div id="form-equipe-container" class="hidden mt-8 p-6 bg-white rounded-lg shadow">
                    <h4 id="form-title-equipe" class="text-2xl font-bold text-[#3B2C5B] mb-4">Adicionar Novo Membro</h4>
                    <form id="form-equipe" action="/admin/adicionar-equipe" method="POST" class="space-y-6">
                        <input type="hidden" name="id" id="equipe-id-input">
                        <input type="text" name="nome" id="equipe-nome-input" placeholder="Nome" required class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="text" name="funcao" id="equipe-funcao-input" placeholder="Função" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <textarea name="descricao" id="equipe-descricao-input" placeholder="Descrição" rows="4" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors"></textarea>
                        <input type="text" name="foto_url" id="equipe-foto_url-input" placeholder="URL da Foto" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="text" name="lattes_url" id="equipe-lattes_url-input" placeholder="URL do Lattes" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="text" name="email" id="equipe-email-input" placeholder="Email" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="password" name="senha" id="equipe-senha-input" placeholder="Senha" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="text" name="permissao" id="equipe-permissao-input" placeholder="Permissão" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <button type="submit" class="btn-roxo">Salvar</button>
                    </form>
                </div>
                <div class="mt-8">
                    <h4 class="text-2xl font-bold text-[#3B2C5B] mb-4">Membros Existentes</h4>
                    <ul class="space-y-4">
                        <% equipe.forEach(item => { %>
                        <li class="bg-white p-4 rounded-lg shadow flex items-center justify-between">
                            <div><h5 class="font-bold text-[#3B2C5B]"><%= item.nome %></h5></div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick='preencherFormEquipe(<%= JSON.stringify(item) %>)' class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">Alterar</button>
                                <form action="/admin/deletar-equipe/<%= item.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este item?');">
                                    <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-700 transition-colors">Deletar</button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </main>
    </div>
</section>

<script>
    function preencherFormEquipe(item) {
        document.getElementById('form-equipe-container').classList.remove('hidden');
        document.getElementById('form-title-equipe').innerText = 'Alterar Membro';
        document.getElementById('form-equipe').action = '/admin/alterar-equipe/' + item.id;
        document.getElementById('equipe-id-input').value = item.id;
        document.getElementById('equipe-nome-input').value = item.nome;
        document.getElementById('equipe-funcao-input').value = item.funcao;
        document.getElementById('equipe-descricao-input').value = item.descricao;
        document.getElementById('equipe-foto_url-input').value = item.foto_url;
        document.getElementById('equipe-lattes_url-input').value = item.lattes_url;
        document.getElementById('equipe-email-input').value = item.email;
        document.getElementById('equipe-senha-input').value = '';
        document.getElementById('equipe-permissao-input').value = item.permissao;
    }
    document.getElementById('btn-adicionar-equipe').addEventListener('click', function() {
        document.getElementById('form-equipe-container').classList.remove('hidden');
        document.getElementById('form-title-equipe').innerText = 'Adicionar Novo Membro';
        document.getElementById('form-equipe').action = '/admin/adicionar-equipe';
        document.getElementById('form-equipe').reset();
    });
</script>
<%- include('../footer.ejs') %>