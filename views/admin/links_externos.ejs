<%- include('../header.ejs') %>
<link rel="stylesheet" href="/admin.css">

<section class="admin-page animate-on-scroll">
    <div class="admin-shell">

        <div class="admin-topbar">
            <span class="admin-topbar__title">Painel NuAR</span>
            <button type="button" id="adminSidebarOpenBtn" class="admin-topbar__toggle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                Menu
            </button>
        </div>

        <%- include('../_admin_sidebar.ejs') %>

        <main class="admin-main">
            <div class="admin-card">
                <div class="admin-page-header">
                    <div>
                        <span class="admin-page-header__eyebrow">Painel de administração</span>
                        <h2 class="admin-page-header__title">Links externos</h2>
                        <p class="admin-page-header__count"><%= links.length %> link<%= links.length === 1 ? '' : 's' %> cadastrado<%= links.length === 1 ? '' : 's' %></p>
                    </div>
                    <button id="btn-adicionar-link" class="admin-btn admin-btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Link
                    </button>
                </div>

                <% if (typeof sucesso !== 'undefined' && sucesso) {
                    let msg = 'Alteração realizada com sucesso!';
                    if (sucesso === 'true') msg = 'Link adicionado com sucesso!';
                    else if (sucesso === 'alterado') msg = 'Link atualizado com sucesso!';
                    else if (sucesso === 'deletado') msg = 'Link removido com sucesso!';
                %>
                    <div class="admin-alert admin-alert--success">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                        </svg>
                        <span><%= msg %></span>
                    </div>
                <% } %>

                <div id="form-links-container" class="admin-form-panel hidden">
                    <h4 id="form-title-link" class="admin-form-panel__title">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Novo Link
                    </h4>
                    <form id="form-link" action="/admin/adicionar-link-externo" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="id" id="link-id-input">
                        <div class="admin-form-grid">
                            <div class="admin-field admin-field--full">
                                <label for="link-titulo-input">Título do link</label>
                                <input type="text" name="titulo" id="link-titulo-input" placeholder="Ex: Edição VOX #4" required class="admin-input">
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="link-url-input">URL completa</label>
                                <input type="url" name="url" id="link-url-input" placeholder="Ex: https://site.com" required class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="link-ano_c-input">Ano de criação</label>
                                <input type="number" name="ano_c" id="link-ano_c-input" placeholder="Ex: 2026" required class="admin-input">
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="link-descricao-input">Descrição <span class="admin-hint">(opcional)</span></label>
                                <textarea name="descricao" id="link-descricao-input" placeholder="Descrição do link" rows="3" class="admin-textarea"></textarea>
                            </div>
                        </div>
                        <div class="admin-form-actions">
                            <button type="submit" class="admin-btn admin-btn--primary">Salvar</button>
                        </div>
                    </form>
                </div>

                <div class="admin-section-heading">
                    <h4 class="admin-section-heading__title">Links existentes</h4>
                </div>

                <% if (links.length > 0) { %>
                    <div class="admin-search">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                        <input type="text" id="link-search-input" placeholder="Buscar por título ou URL...">
                    </div>
                <% } %>

                <% if (links.length === 0) { %>
                    <div class="admin-empty-state">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5"/>
                        </svg>
                        <p>Nenhum link externo cadastrado ainda.</p>
                    </div>
                <% } else { %>
                    <ul class="admin-item-list">
                        <% links.forEach(item => { %>
                        <li class="admin-item-card" data-search="<%= item.titulo %> <%= item.url %>">
                            <div class="admin-item-card__main">
                                <div class="admin-item-card__body">
                                    <h5 class="admin-item-card__title"><%= item.titulo %> <span class="admin-badge admin-badge--accent"><%= item.ano_c %></span></h5>
                                    <div class="admin-item-card__meta">
                                        <a href="<%= item.url %>" target="_blank" rel="noopener"><%= item.url %></a>
                                    </div>
                                    <% if (item.descricao) { %>
                                        <p class="admin-item-card__desc"><%= item.descricao %></p>
                                    <% } %>
                                    <% if (item.modificado_em) { %>
                                        <span class="admin-item-card__updated">Atualizado em <%= new Date(item.modificado_em).toLocaleDateString('pt-BR') %><% if (item.modificado_por) { %> por <%= item.modificado_por %><% } %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="admin-item-card__actions">
                                <button type="button" onclick='preencherFormLink(<%- JSON.stringify(item) %>)' class="admin-btn admin-btn--edit admin-btn--sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
                                    Alterar
                                </button>
                                <form action="/admin/deletar-link-externo/<%= item.id %>" method="POST" data-confirm="Tem certeza que deseja deletar o link &quot;<%= item.titulo %>&quot;?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                                        Deletar
                                    </button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                    <p id="link-search-no-results" class="admin-search__no-results">Nenhum link encontrado para essa busca.</p>
                <% } %>
            </div>
        </main>
    </div>
</section>

<script src="/admin.js"></script>
<script>
    window.setupListSearch({
        input: 'link-search-input',
        cardSelector: '.admin-item-list .admin-item-card',
        noResults: 'link-search-no-results'
    });

    function preencherFormLink(item) {
        document.getElementById('form-links-container').classList.remove('hidden');
        document.getElementById('form-title-link').innerText = 'Alterar Link Externo';
        document.getElementById('form-link').action = '/admin/alterar-link-externo/' + item.id;
        document.getElementById('link-id-input').value = item.id;
        document.getElementById('link-titulo-input').value = item.titulo;
        document.getElementById('link-url-input').value = item.url;
        document.getElementById('link-ano_c-input').value = item.ano_c;
        document.getElementById('link-descricao-input').value = item.descricao;
        document.getElementById('form-links-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    document.getElementById('btn-adicionar-link').addEventListener('click', function() {
        document.getElementById('form-links-container').classList.remove('hidden');
        document.getElementById('form-title-link').innerText = 'Adicionar Novo Link';
        document.getElementById('form-link').action = '/admin/adicionar-link-externo';
        document.getElementById('form-link').reset();
    });
</script>
<%- include('../footer.ejs') %>
