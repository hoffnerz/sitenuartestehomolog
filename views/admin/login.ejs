<%- include('../header.ejs') %>
<link rel="stylesheet" href="/admin.css">

<section class="admin-login-wrap animate-on-scroll">
    <div class="admin-login-card">
        <img class="admin-login-card__logo" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIqgzSWlM1EQ4CZ8vYqYBVAtYD0yfehFwAfg&s" alt="Logo NuAR">
        <h2 class="admin-login-card__title">Painel de Administração</h2>
        <p class="admin-login-card__subtitle">Entre com suas credenciais do NuAR para gerenciar o conteúdo do site.</p>

        <% if (erro) { %>
            <div class="admin-alert" style="background-color:#FDECEC; color:#C0342A; border:1px solid #F7C6C2;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                </svg>
                <span><%= erro %></span>
            </div>
        <% } %>

        <form action="/admin/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="admin-field">
                <label for="login-email">Email</label>
                <input type="text" name="email" id="login-email" placeholder="seuemail@ifms.edu.br" required class="admin-input">
            </div>
            <div class="admin-field">
                <label for="login-senha">Senha</label>
                <input type="password" name="senha" id="login-senha" placeholder="••••••••" required class="admin-input">
            </div>
            <button type="submit" class="admin-btn admin-btn--primary admin-btn--full">Entrar</button>
        </form>
    </div>
</section>

<%- include('../footer.ejs') %>
