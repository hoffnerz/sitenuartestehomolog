<%- include('../header.ejs') %>

<section class="bg-white py-24 md:py-40 px-4 animate-on-scroll min-h-screen">
    <div class="container mx-auto max-w-7xl flex flex-col md:flex-row gap-10">
        <%- include('../_admin_sidebar.ejs') %>
        <main class="w-full md:w-3/4 bg-[#f0f0f0] p-10 rounded-3xl shadow-lg">
            <h2 class="text-4xl font-bold text-[#3B2C5B] mb-8">Painel de Administração - Produções</h2>

            <% if (typeof sucesso !== 'undefined') { %>
                <div class="bg-green-200 text-green-800 p-4 rounded-md mb-6">
                    <p>Item adicionado/deletado/alterado com sucesso!</p>
                </div>
            <% } %>

            <div id="producoes-form" class="space-y-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-3xl font-bold text-[#3B2C5B]">Produções</h3>
                    <button id="btn-adicionar-producao" class="bg-[#C46ED8] text-white px-4 py-2 rounded hover:bg-[#8C40B8] transition-colors">Adicionar Produção</button>
                </div>
                <div id="form-producoes-container" class="hidden mt-8 p-6 bg-white rounded-lg shadow">
                    <h4 id="form-title-producao" class="text-2xl font-bold text-[#3B2C5B] mb-4">Adicionar Nova Produção</h4>
                    <form id="form-producao" action="/admin/adicionar-producao" method="POST" class="space-y-6">
                        <input type="hidden" name="id" id="producao-id-input">
                        <input type="text" name="titulo" id="producao-titulo-input" placeholder="Título" required class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <textarea name="descricao" id="producao-descricao-input" placeholder="Descrição" required rows="4" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors"></textarea>
                        <input type="text" name="link_externo" id="producao-link_externo-input" placeholder="Link Externo" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <input type="date" name="data_publicacao" id="producao-data_publicacao-input" placeholder="Data de Publicação" required class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                        <select name="projeto_id" id="producao-projeto_id-input" class="w-full px-4 py-3 rounded-md border-2 border-gray-300 focus:outline-none focus:border-[#C46ED8] transition-colors">
                            <option value="">-- Selecione um Projeto --</option>
                            <% projetos.forEach(item => { %>
                                <option value="<%= item.id %>"><%= item.titulo %></option>
                            <% }) %>
                        </select>
                        <button type="submit" class="btn-roxo">Salvar</button>
                    </form>
                </div>
                <div class="mt-8">
                    <h4 class="text-2xl font-bold text-[#3B2C5B] mb-4">Producoes Existentes</h4>
                    <ul class="space-y-4">
                        <% producoes.forEach(item => { %>
                        <li class="bg-white p-4 rounded-lg shadow flex items-center justify-between">
                            <div><h5 class="font-bold text-[#3B2C5B]"><%= item.titulo %></h5></div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick='preencherFormProducao(<%= JSON.stringify(item) %>)' class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">Alterar</button>
                                <form action="/admin/deletar-producao/<%= item.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este item?');">
                                    <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-700 transition-colors">Deletar</button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </main>
    </div>
</section>

<script>
    function preencherFormProducao(item) {
        document.getElementById('form-producoes-container').classList.remove('hidden');
        document.getElementById('form-title-producao').innerText = 'Alterar Produção';
        document.getElementById('form-producao').action = '/admin/alterar-producao/' + item.id;
        document.getElementById('producao-id-input').value = item.id;
        document.getElementById('producao-titulo-input').value = item.titulo;
        document.getElementById('producao-descricao-input').value = item.descricao;
        document.getElementById('producao-link_externo-input').value = item.link_externo;
        document.getElementById('producao-data_publicacao-input').value = item.data_publicacao ? new Date(item.data_publicacao).toISOString().split('T')[0] : '';
        document.getElementById('producao-projeto_id-input').value = item.projeto_id;
    }
    document.getElementById('btn-adicionar-producao').addEventListener('click', function() {
        document.getElementById('form-producoes-container').classList.remove('hidden');
        document.getElementById('form-title-producao').innerText = 'Adicionar Nova Produção';
        document.getElementById('form-producao').action = '/admin/adicionar-producao';
        document.getElementById('form-producao').reset();
    });
</script>
<%- include('../footer.ejs') %>