<%- include('../header.ejs') %>
<link rel="stylesheet" href="/admin.css">

<section class="admin-page animate-on-scroll">
    <div class="admin-shell">

        <div class="admin-topbar">
            <span class="admin-topbar__title">Painel NuAR</span>
            <button type="button" id="adminSidebarOpenBtn" class="admin-topbar__toggle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                Menu
            </button>
        </div>

        <%- include('../_admin_sidebar.ejs') %>

        <main class="admin-main">
            <div class="admin-card">
                <div class="admin-page-header">
                    <div>
                        <span class="admin-page-header__eyebrow">Painel de administração</span>
                        <h2 class="admin-page-header__title">Notícias</h2>
                        <p class="admin-page-header__count"><%= noticias.length %> notícia<%= noticias.length === 1 ? '' : 's' %> cadastrada<%= noticias.length === 1 ? '' : 's' %></p>
                    </div>
                    <button id="btn-adicionar-noticia" class="admin-btn admin-btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Notícia
                    </button>
                </div>

                <% if (typeof sucesso !== 'undefined' && sucesso) {
                    let msg = 'Alteração realizada com sucesso!';
                    if (sucesso === 'true') msg = 'Notícia adicionada com sucesso!';
                    else if (sucesso === 'alterado') msg = 'Notícia atualizada com sucesso!';
                    else if (sucesso === 'deletado') msg = 'Notícia removida com sucesso!';
                %>
                    <div class="admin-alert admin-alert--success">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                        </svg>
                        <span><%= msg %></span>
                    </div>
                <% } %>

                <div id="form-noticias-container" class="admin-form-panel hidden">
                    <h4 id="form-title-noticia" class="admin-form-panel__title">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Nova Notícia
                    </h4>
                    <form id="form-noticia" action="/admin/adicionar-noticia" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="id" id="noticia-id-input">
                        <div class="admin-form-grid">
                            <div class="admin-field admin-field--full">
                                <label for="noticia-titulo-input">Título</label>
                                <input type="text" name="titulo" id="noticia-titulo-input" placeholder="Título da notícia" required class="admin-input">
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="noticia-conteudo-input">Conteúdo</label>
                                <textarea name="conteudo" id="noticia-conteudo-input" placeholder="Conteúdo da notícia" required rows="8" class="admin-textarea"></textarea>
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="noticia-link_externo-input">Link externo</label>
                                <input type="text" name="link_externo" id="noticia-link_externo-input" placeholder="https://..." class="admin-input">
                            </div>
                        </div>
                        <div class="admin-form-actions">
                            <button type="submit" class="admin-btn admin-btn--primary">Salvar</button>
                        </div>
                    </form>
                </div>

                <div class="admin-section-heading">
                    <h4 class="admin-section-heading__title">Notícias existentes</h4>
                </div>

                <% if (noticias.length > 0) { %>
                    <div class="admin-search">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                        <input type="text" id="noticia-search-input" placeholder="Buscar por título ou conteúdo...">
                    </div>
                <% } %>

                <% if (noticias.length === 0) { %>
                    <div class="admin-empty-state">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m4 13a2 2 0 01-2-2V7a2 2 0 00-2-2"/>
                        </svg>
                        <p>Nenhuma notícia cadastrada ainda.</p>
                    </div>
                <% } else { %>
                    <ul class="admin-item-list">
                        <% noticias.forEach(item => { %>
                        <li class="admin-item-card" data-search="<%= item.titulo %> <%= item.conteudo %>">
                            <div class="admin-item-card__main">
                                <div class="admin-item-card__body">
                                    <h5 class="admin-item-card__title"><%= item.titulo %></h5>
                                    <% if (item.link_externo) { %>
                                        <div class="admin-item-card__meta">
                                            <a href="<%= item.link_externo %>" target="_blank" rel="noopener">Ver link externo →</a>
                                        </div>
                                    <% } %>
                                    <% if (item.conteudo) { %>
                                        <p class="admin-item-card__desc"><%= item.conteudo %></p>
                                    <% } %>
                                    <% if (item.modificado_em) { %>
                                        <span class="admin-item-card__updated">Atualizado em <%= new Date(item.modificado_em).toLocaleDateString('pt-BR') %><% if (item.modificado_por) { %> por <%= item.modificado_por %><% } %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="admin-item-card__actions">
                                <button type="button" onclick='preencherFormNoticia(<%- JSON.stringify(item) %>)' class="admin-btn admin-btn--edit admin-btn--sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
                                    Alterar
                                </button>
                                <form action="/admin/deletar-noticia/<%= item.id %>" method="POST" data-confirm="Tem certeza que deseja deletar a notícia &quot;<%= item.titulo %>&quot;?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                                        Deletar
                                    </button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                    <p id="noticia-search-no-results" class="admin-search__no-results">Nenhuma notícia encontrada para essa busca.</p>
                <% } %>
            </div>
        </main>
    </div>
</section>

<script src="/admin.js"></script>
<script>
    window.setupListSearch({
        input: 'noticia-search-input',
        cardSelector: '.admin-item-list .admin-item-card',
        noResults: 'noticia-search-no-results'
    });

    function preencherFormNoticia(item) {
        document.getElementById('form-noticias-container').classList.remove('hidden');
        document.getElementById('form-title-noticia').innerText = 'Alterar Notícia';
        document.getElementById('form-noticia').action = '/admin/alterar-noticia/' + item.id;
        document.getElementById('noticia-id-input').value = item.id;
        document.getElementById('noticia-titulo-input').value = item.titulo;
        document.getElementById('noticia-conteudo-input').value = item.conteudo;
        document.getElementById('noticia-link_externo-input').value = item.link_externo;
        document.getElementById('form-noticias-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    document.getElementById('btn-adicionar-noticia').addEventListener('click', function() {
        document.getElementById('form-noticias-container').classList.remove('hidden');
        document.getElementById('form-title-noticia').innerText = 'Adicionar Nova Notícia';
        document.getElementById('form-noticia').action = '/admin/adicionar-noticia';
        document.getElementById('form-noticia').reset();
    });
</script>
<%- include('../footer.ejs') %>
