<%- include('../header.ejs') %>
<link rel="stylesheet" href="/admin.css">

<section class="admin-page animate-on-scroll">
    <div class="admin-shell">

        <div class="admin-topbar">
            <span class="admin-topbar__title">Painel NuAR</span>
            <button type="button" id="adminSidebarOpenBtn" class="admin-topbar__toggle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                Menu
            </button>
        </div>

        <%- include('../_admin_sidebar.ejs') %>

        <main class="admin-main">
            <div class="admin-card">
                <div class="admin-page-header">
                    <div>
                        <span class="admin-page-header__eyebrow">Painel de administração</span>
                        <h2 class="admin-page-header__title">Editais</h2>
                        <p class="admin-page-header__count"><%= editais.length %> edital<%= editais.length === 1 ? '' : 'is' %> cadastrado<%= editais.length === 1 ? '' : 's' %></p>
                    </div>
                    <button id="btn-adicionar-edital" class="admin-btn admin-btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Edital
                    </button>
                </div>

                <% if (typeof sucesso !== 'undefined' && sucesso) {
                    let msg = 'Alteração realizada com sucesso!';
                    if (sucesso === 'true') msg = 'Edital adicionado com sucesso!';
                    else if (sucesso === 'alterado') msg = 'Edital atualizado com sucesso!';
                    else if (sucesso === 'deletado') msg = 'Edital removido com sucesso!';
                %>
                    <div class="admin-alert admin-alert--success">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                        </svg>
                        <span><%= msg %></span>
                    </div>
                <% } %>

                <div id="form-editais-container" class="admin-form-panel hidden">
                    <h4 id="form-title-edital" class="admin-form-panel__title">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Adicionar Novo Edital
                    </h4>
                    <form id="form-edital" action="/admin/adicionar-edital" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="id" id="edital-id-input">
                        <div class="admin-form-grid">
                            <div class="admin-field admin-field--full">
                                <label for="edital-titulo-input">Título</label>
                                <input type="text" name="titulo" id="edital-titulo-input" placeholder="Título do edital" required class="admin-input">
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="edital-descricao-input">Descrição</label>
                                <textarea name="descricao" id="edital-descricao-input" placeholder="Descrição do edital" rows="4" class="admin-textarea"></textarea>
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="edital-status-input">Status</label>
                                <input type="text" name="status" id="edital-status-input" placeholder="Ex: Aberto, Encerrado" class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="edital-data_inicio-input">Data de início</label>
                                <input type="date" name="data_inicio" id="edital-data_inicio-input" class="admin-input">
                            </div>
                            <div class="admin-field">
                                <label for="edital-data_fim-input">Data de fim</label>
                                <input type="date" name="data_fim" id="edital-data_fim-input" class="admin-input">
                            </div>
                            <div class="admin-field admin-field--full">
                                <label for="edital-projeto_id-input">Projeto vinculado</label>
                                <select name="projeto_id" id="edital-projeto_id-input" class="admin-select">
                                    <option value="">-- Selecione um Projeto --</option>
                                    <% projetos.forEach(item => { %>
                                        <option value="<%= item.id %>"><%= item.titulo %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="admin-form-actions">
                            <button type="submit" class="admin-btn admin-btn--primary">Salvar</button>
                        </div>
                    </form>
                </div>

                <div class="admin-section-heading">
                    <h4 class="admin-section-heading__title">Editais existentes</h4>
                </div>

                <% if (editais.length > 0) { %>
                    <div class="admin-search">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                        <input type="text" id="edital-search-input" placeholder="Buscar por título, status ou descrição...">
                    </div>
                <% } %>

                <% if (editais.length === 0) { %>
                    <div class="admin-empty-state">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
                        </svg>
                        <p>Nenhum edital cadastrado ainda.</p>
                    </div>
                <% } else { %>
                    <ul class="admin-item-list">
                        <% editais.forEach(item => { %>
                        <li class="admin-item-card" data-search="<%= item.titulo %> <%= item.descricao %> <%= item.status %>">
                            <div class="admin-item-card__main">
                                <div class="admin-item-card__body">
                                    <h5 class="admin-item-card__title"><%= item.titulo %></h5>
                                    <div class="admin-item-card__meta">
                                        <% if (item.status) { %>
                                            <span class="admin-badge admin-badge--accent"><%= item.status %></span>
                                        <% } %>
                                        <% if (item.data_inicio) { %>
                                            <span class="admin-badge"><%= new Date(item.data_inicio).toLocaleDateString('pt-BR') %><% if (item.data_fim) { %> – <%= new Date(item.data_fim).toLocaleDateString('pt-BR') %><% } %></span>
                                        <% } %>
                                    </div>
                                    <% if (item.descricao) { %>
                                        <p class="admin-item-card__desc"><%= item.descricao %></p>
                                    <% } %>
                                    <% if (item.modificado_em) { %>
                                        <span class="admin-item-card__updated">Atualizado em <%= new Date(item.modificado_em).toLocaleDateString('pt-BR') %><% if (item.modificado_por) { %> por <%= item.modificado_por %><% } %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="admin-item-card__actions">
                                <button type="button" onclick='preencherFormEdital(<%- JSON.stringify(item) %>)' class="admin-btn admin-btn--edit admin-btn--sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
                                    Alterar
                                </button>
                                <form action="/admin/deletar-edital/<%= item.id %>" method="POST" data-confirm="Tem certeza que deseja deletar o edital &quot;<%= item.titulo %>&quot;?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                                        Deletar
                                    </button>
                                </form>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                    <p id="edital-search-no-results" class="admin-search__no-results">Nenhum edital encontrado para essa busca.</p>
                <% } %>
            </div>
        </main>
    </div>
</section>

<script src="/admin.js"></script>
<script>
    window.setupListSearch({
        input: 'edital-search-input',
        cardSelector: '.admin-item-list .admin-item-card',
        noResults: 'edital-search-no-results'
    });

    function preencherFormEdital(item) {
        document.getElementById('form-editais-container').classList.remove('hidden');
        document.getElementById('form-title-edital').innerText = 'Alterar Edital';
        document.getElementById('form-edital').action = '/admin/alterar-edital/' + item.id;
        document.getElementById('edital-id-input').value = item.id;
        document.getElementById('edital-titulo-input').value = item.titulo;
        document.getElementById('edital-descricao-input').value = item.descricao;
        document.getElementById('edital-status-input').value = item.status;
        document.getElementById('edital-data_inicio-input').value = item.data_inicio ? new Date(item.data_inicio).toISOString().split('T')[0] : '';
        document.getElementById('edital-data_fim-input').value = item.data_fim ? new Date(item.data_fim).toISOString().split('T')[0] : '';
        document.getElementById('edital-projeto_id-input').value = item.projeto_id;
        document.getElementById('form-editais-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    document.getElementById('btn-adicionar-edital').addEventListener('click', function() {
        document.getElementById('form-editais-container').classList.remove('hidden');
        document.getElementById('form-title-edital').innerText = 'Adicionar Novo Edital';
        document.getElementById('form-edital').action = '/admin/adicionar-edital';
        document.getElementById('form-edital').reset();
    });
</script>
<%- include('../footer.ejs') %>
