<%- include('header.ejs') %>

<section id="participacao-editais" class="bg-[#f8f4ff] py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-4xl">
        <div class="text-center mb-16">
            <span class="section-label">Oportunidades</span>
            <h2 class="section-title">Participação em Editais</h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto mt-4">Editais e chamadas públicas em que o NuAR participa ou participou.</p>
        </div>

        <div class="space-y-6">
            <% editais.forEach(edital => { %>
            <article class="edital-card group">
                <div class="flex flex-col md:flex-row md:items-start gap-5">
                    <div class="flex-shrink-0">
                        <div class="edital-status-icon
                            <% if (edital.status && edital.status.toLowerCase().includes('aberto')) { %>
                                edital-status-open
                            <% } else if (edital.status && edital.status.toLowerCase().includes('encerrado')) { %>
                                edital-status-closed
                            <% } else { %>
                                edital-status-default
                            <% } %>">
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h2 class="text-xl font-bold text-[#3B2C5B] leading-tight group-hover:text-[#C46ED8] transition-colors">
                                <%= edital.titulo %>
                            </h2>
                            <% if (edital.status) { %>
                                <span class="edital-badge
                                    <% if (edital.status.toLowerCase().includes('aberto')) { %>
                                        edital-badge-open
                                    <% } else if (edital.status.toLowerCase().includes('encerrado')) { %>
                                        edital-badge-closed
                                    <% } else { %>
                                        edital-badge-default
                                    <% } %>">
                                    <%= edital.status %>
                                </span>
                            <% } %>
                        </div>
                        <% if (edital.descricao) { %>
                            <p class="text-gray-600 leading-relaxed mb-4"><%= edital.descricao %></p>
                        <% } %>
                        <% if (edital.data_inicio && edital.data_fim) { %>
                            <p class="text-sm text-gray-400 mb-3 inline-flex items-center gap-1.5">
                                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
                                <%= new Date(edital.data_inicio).toLocaleDateString('pt-BR') %> &mdash; <%= new Date(edital.data_fim).toLocaleDateString('pt-BR') %>
                            </p>
                        <% } %>
                        <% if (edital.link_externo) { %>
                        <div class="mt-2">
                            <a href="<%= edital.link_externo %>" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-2 text-sm font-semibold text-[#C46ED8] hover:text-[#8C40B8] transition-colors">
                                Acessar edital completo
                                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </a>
                        </div>
                        <% } %>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (!editais || editais.length === 0) { %>
            <div class="text-center py-20">
                <p class="text-gray-400 text-lg">Nenhum edital cadastrado ainda.</p>
            </div>
        <% } %>
    </div>
</section>

<%- include('footer.ejs') %>
