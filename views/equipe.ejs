<%- include('header.ejs') %>

<section id="equipe" class="bg-[#f8f4ff] py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-7xl">
        <div class="text-center mb-16">
            <span class="section-label">Quem somos</span>
            <h2 class="section-title">Nossa Equipe Criativa</h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto mt-4">
                Conheça as mentes criativas e os profissionais dedicados que impulsionam os projetos do NuAR, transformando ideias em realidade.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% equipe.forEach(membro => { %>
            <article class="membro-card group">
                <div class="membro-avatar-wrapper">
                    <img
                        src="<%= membro.foto_url || 'https://placehold.co/200x200/D9CFF0/3B2C5B?text=' + encodeURIComponent(membro.nome ? membro.nome.charAt(0) : 'N') %>"
                        alt="Foto de <%= membro.nome %>"
                        loading="lazy"
                        class="membro-avatar"
                    >
                </div>
                <div class="membro-info">
                    <h3 class="text-lg font-bold text-[#3B2C5B] mb-1 leading-tight"><%= membro.nome %></h3>
                    <% if (membro.funcao || membro.cargo) { %>
                        <p class="text-sm font-semibold text-[#C46ED8] mb-3"><%= membro.funcao || membro.cargo %></p>
                    <% } %>
                    <% if (membro.descricao) { %>
                        <p class="text-sm text-gray-500 leading-relaxed mb-4 line-clamp-3"><%= membro.descricao %></p>
                    <% } %>
                    <% if (membro.lattes_url) { %>
                        <a href="<%= membro.lattes_url %>" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#C46ED8] hover:text-[#8C40B8] transition-colors">
                            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg>
                            Currículo Lattes
                        </a>
                    <% } %>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (!equipe || equipe.length === 0) { %>
            <div class="text-center py-20">
                <p class="text-gray-400 text-lg">Nenhum membro cadastrado ainda.</p>
            </div>
        <% } %>
    </div>
</section>

<%- include('footer.ejs') %>
