<%- include('header.ejs') %>

<section id="equipe" class="bg-[#f0f0f0] py-24 md:py-40 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-7xl text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-[#3B2C5B] text-center mb-16">Nossa Equipe Criativa</h2>
        <p class="text-xl md:text-2xl text-gray-700 mb-12 leading-relaxed">
            Conheça as mentes criativas e os profissionais dedicados que impulsionam os projetos do NuAR, transformando ideias em realidade.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% equipe.forEach(membro => { %>
            <div class="bg-white card-style p-8 flex flex-col items-center text-center">
                <img 
                    src="<%= membro.foto_url || 'https://placehold.co/150x150/D9CFF0/3B2C5B' %>" 
                    alt="[Foto do Membro da Equipe]" 
                    loading="lazy" 
                    class="rounded-full w-36 h-36 object-cover mb-5 border-4 border-[#C46ED8] shadow-md"
                >
                
                <h3 class="text-2xl font-bold text-[#3B2C5B] mb-2"><%= membro.nome %></h3>
                
                <p class="text-lg text-[#6B4F9E] mb-4 font-semibold"><%= membro.cargo %></p>
                
                <p class="text-base text-gray-600 mb-4"><%= membro.descricao %></p>

                <% if (membro.lattes_url) { %>
                <a href="<%= membro.lattes_url %>" target="_blank" class="text-blue-500 underline text-sm">Currículo Lattes</a>
                <% } %>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<%- include('footer.ejs') %>
