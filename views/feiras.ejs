<%- include('header.ejs') %>

<section id="feiras-e-mostras" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-5xl">
        <div class="text-center mb-16">
            <span class="section-label">Presença Nacional</span>
            <h2 class="section-title">Feiras e Mostras Científicas</h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto mt-4">Eventos em que o NuAR apresentou seus projetos e conquistou reconhecimento.</p>
        </div>

        <div class="space-y-5">
            <% feiras.forEach(feira => { %>
            <article class="feira-card group">
                <div class="flex flex-col md:flex-row md:items-start gap-5">
                    <div class="flex-shrink-0">
                        <div class="feira-year-badge">
                            <%= feira.ano %>
                        </div>
                    </div>
                    <div class="flex-grow">
                        <% if (feira.imagens && feira.imagens.length) { %>
                        <div class="feira-carousel relative mb-5" data-carousel>
                            <div class="overflow-hidden rounded-xl">
                                <% feira.imagens.forEach((imagem, indice) => { %>
                                <img src="<%= imagem %>" alt="<%= feira.titulo %> — imagem <%= indice + 1 %>" loading="lazy" class="w-full h-56 md:h-72 object-cover <%= indice === 0 ? '' : 'hidden' %>" data-slide>
                                <% }) %>
                            </div>
                            <% if (feira.imagens.length > 1) { %>
                            <button type="button" data-prev aria-label="Imagem anterior" class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 shadow">‹</button>
                            <button type="button" data-next aria-label="Próxima imagem" class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 shadow">›</button>
                            <div class="flex justify-center gap-2 mt-3"><% feira.imagens.forEach((_, indice) => { %><button type="button" data-dot="<%= indice %>" aria-label="Ir para imagem <%= indice + 1 %>" class="h-2.5 w-2.5 rounded-full <%= indice === 0 ? 'bg-[#C46ED8]' : 'bg-gray-300' %>"></button><% }) %></div>
                            <% } %>
                        </div>
                        <% } %>
                        <h2 class="text-xl font-bold text-[#3B2C5B] mb-2 leading-tight group-hover:text-[#C46ED8] transition-colors">
                            <%= feira.titulo %>
                        </h2>
                        <% if (feira.descricao) { %>
                            <p class="text-gray-600 leading-relaxed mb-4"><%= feira.descricao %></p>
                        <% } %>
                        <% if (feira.link_externo) { %>
                        <a href="<%= feira.link_externo %>" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-2 text-sm font-semibold text-[#C46ED8] hover:text-[#8C40B8] transition-colors">
                            Saiba mais
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                        </a>
                        <% } %>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (!feiras || feiras.length === 0) { %>
            <div class="text-center py-20">
                <p class="text-gray-400 text-lg">Nenhuma feira cadastrada ainda.</p>
            </div>
        <% } %>
    </div>
</section>

<script>
    document.querySelectorAll('[data-carousel]').forEach(carousel => {
        const slides = [...carousel.querySelectorAll('[data-slide]')];
        const dots = [...carousel.querySelectorAll('[data-dot]')];
        let atual = 0;
        const mostrar = indice => {
            atual = (indice + slides.length) % slides.length;
            slides.forEach((slide, i) => slide.classList.toggle('hidden', i !== atual));
            dots.forEach((dot, i) => { dot.classList.toggle('bg-[#C46ED8]', i === atual); dot.classList.toggle('bg-gray-300', i !== atual); });
        };
        carousel.querySelector('[data-prev]')?.addEventListener('click', () => mostrar(atual - 1));
        carousel.querySelector('[data-next]')?.addEventListener('click', () => mostrar(atual + 1));
        dots.forEach(dot => dot.addEventListener('click', () => mostrar(Number(dot.dataset.dot))));
    });
</script>
<%- include('footer.ejs') %>
