<%- include('header.ejs') %>

<section id="feiras-e-mostras" class="bg-[#f0f0f0] py-24 md:py-40 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-7xl">
        <h2 class="text-4xl md:text-5xl font-bold text-[#3B2C5B] text-center mb-16">Feiras e Mostras Científicas</h2>
        <ul class="list-none p-0 m-0 text-gray-700 space-y-6 max-w-4xl mx-auto">
            <% feiras.forEach(feira => { %>
            <li class="bg-white card-style p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between">
                    <h2 class="font-bold text-[#3B2C5B] text-xl mb-2 md:mb-0"><%= feira.titulo %></h2>

                    <span class="text-sm font-semibold text-gray-500 mt-2 md:mt-0"><%= feira.ano %></span>
                </div>
                <p class="text-base text-gray-600 mt-4"><%= feira.descricao %></p>

                <% if (feira.link_externo) { %>
                <div class="mt-4">
                    <a href="<%= feira.link_externo %>" target="_blank" class="text-blue-500 underline text-sm">Saiba mais</a>
                </div>
                <% } %>
            </li>
            <% }) %>
        </ul>
    </div>
</section>

<%- include('footer.ejs') %>
