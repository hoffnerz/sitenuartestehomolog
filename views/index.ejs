<%- include('header.ejs') %>

<!-- ===== HERO / INÍCIO ===== -->
<section id="inicio" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-7xl flex flex-col md:flex-row items-center gap-12 md:gap-20">
        <div class="md:w-1/2 text-center md:text-left">
            <span class="inline-block text-sm font-bold text-[#C46ED8] uppercase tracking-widest mb-4 bg-purple-50 px-4 py-1.5 rounded-full"><%= homepage.hero.etiqueta %></span>
            <h1 class="text-5xl md:text-6xl font-black text-[#3B2C5B] mb-6 leading-tight whitespace-pre-line"><span class="text-gradient"><%= homepage.hero.titulo %></span></h1>
            <p class="text-lg md:text-xl text-gray-600 mb-10 leading-relaxed max-w-lg">
                <%= homepage.hero.descricao %>
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                <a href="<%= homepage.hero.botao1Url %>" class="btn-primary"><%= homepage.hero.botao1Texto %></a>
                <a href="<%= homepage.hero.botao2Url %>" class="btn-secondary"><%= homepage.hero.botao2Texto %></a>
            </div>
        </div>
        <div class="md:w-1/2 flex justify-center w-full">
            <div class="hero-carousel-container w-full max-w-xl h-72 md:h-96 rounded-3xl shadow-2xl overflow-hidden">
                <% homepage.hero.imagens.forEach((imagem, indice) => { %>
                <img src="<%= imagem %>" alt="<%= homepage.hero.etiqueta %>" class="carousel-slide <%= indice === 0 ? 'active' : '' %> object-cover w-full h-full">
                <% }) %>
                <% if (homepage.hero.imagens.length > 1) { %>
                <button class="carousel-button prev" aria-label="Slide anterior">&#10094;</button>
                <button class="carousel-button next" aria-label="Próximo slide">&#10095;</button>
                <div class="carousel-indicators"><% homepage.hero.imagens.forEach((imagem, indice) => { %><span class="indicator-dot <%= indice === 0 ? 'active' : '' %>" data-slide-to="<%= indice %>"></span><% }) %></div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- ===== LINHA DO TEMPO ===== -->
<section id="linha-do-tempo" class="bg-[#f8f4ff] py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-4xl">
        <div class="text-center mb-16">
            <span class="section-label"><%= homepage.timelineSubtitulo %></span>
            <h2 class="section-title"><%= homepage.timelineTitulo %></h2>
        </div>

        <div class="timeline-wrapper">
            <% homepage.timeline.forEach((item, indice) => { %>
            <div class="timeline-item <%= indice % 2 === 0 ? 'timeline-right' : 'timeline-left' %>">
                <div class="timeline-dot"><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg></div>
                <div class="timeline-card"><span class="timeline-year"><%= item.ano %></span><p class="text-gray-600 leading-relaxed"><%= item.texto %></p></div>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- ===== INFORMAÇÕES INSTITUCIONAIS ===== -->
<section id="institucional" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-5xl">
        <div class="text-center mb-16">
            <span class="section-label"><%= homepage.institucionalSubtitulo %></span>
            <h2 class="section-title"><%= homepage.institucionalTitulo %></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <% homepage.institucional.forEach(item => { %>
            <div class="institutional-card">
                <div class="institutional-card-icon"><svg class="h-8 w-8" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/></svg></div>
                <h3 class="text-xl font-bold text-[#3B2C5B] mb-3"><%= item.titulo %></h3>
                <p class="text-gray-600 leading-relaxed mb-6 flex-grow"><%= item.texto %></p>
                <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="btn-primary self-start"><%= item.botao %></a>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<%- include('footer.ejs') %>
