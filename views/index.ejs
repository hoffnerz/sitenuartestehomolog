<%- include('header.ejs') %>

<!-- ===== HERO / INÍCIO ===== -->
<section id="inicio" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-7xl flex flex-col md:flex-row items-center gap-12 md:gap-20">
        <div class="md:w-1/2 text-center md:text-left">
            <span class="inline-block text-sm font-bold text-[#C46ED8] uppercase tracking-widest mb-4 bg-purple-50 px-4 py-1.5 rounded-full">IFMS Campo Grande</span>
            <h1 class="text-5xl md:text-6xl font-black text-[#3B2C5B] mb-6 leading-tight">
                Núcleo de<br>
                <span class="text-gradient">Animação e<br>Roteiro</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 mb-10 leading-relaxed max-w-lg">
                O NuAR do IFMS é um espaço vibrante dedicado ao desenvolvimento de projetos inovadores nas áreas de animação e escrita criativa, capacitando estudantes e promovendo a cultura e a tecnologia na comunidade.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                <a href="/projetos" class="btn-primary">
                    Conheça Nossos Projetos
                </a>
                <a href="/links" class="btn-secondary">
                    Edições VOX
                </a>
            </div>
        </div>
        <div class="md:w-1/2 flex justify-center w-full">
            <div class="hero-carousel-container w-full max-w-xl h-72 md:h-96 rounded-3xl shadow-2xl overflow-hidden">
                <img src="/Imagens/1.jpg" alt="Imagem do laboratório NuAR" class="carousel-slide active object-cover w-full h-full">
                <img src="/Imagens/2.jpg" alt="Imagem do laboratório NuAR" class="carousel-slide object-cover w-full h-full">
                <button class="carousel-button prev" aria-label="Slide anterior">&#10094;</button>
                <button class="carousel-button next" aria-label="Próximo slide">&#10095;</button>
                <div class="carousel-indicators">
                    <span class="indicator-dot active" data-slide-to="0"></span>
                    <span class="indicator-dot" data-slide-to="1"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== LINHA DO TEMPO ===== -->
<section id="linha-do-tempo" class="bg-[#f8f4ff] py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-4xl">
        <div class="text-center mb-16">
            <span class="section-label">Nossa Trajetória</span>
            <h2 class="section-title">Linha do Tempo</h2>
        </div>

        <div class="timeline-wrapper">

            <div class="timeline-item timeline-right">
                <div class="timeline-dot">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="timeline-card">
                    <span class="timeline-year">2017</span>
                    <p class="text-gray-600 leading-relaxed">Primeiros estudos sobre as técnicas de Animação e Roteiro a partir das poesias dos escritores regionais.</p>
                </div>
            </div>

            <div class="timeline-item timeline-left">
                <div class="timeline-dot">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="timeline-card">
                    <span class="timeline-year">2018</span>
                    <p class="text-gray-600 leading-relaxed">Definição dos temas, envolvimento dos estudantes, discussões em grupo e a definição do nome/slogan do projeto.</p>
                </div>
            </div>

            <div class="timeline-item timeline-right">
                <div class="timeline-dot">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="timeline-card">
                    <span class="timeline-year">2019</span>
                    <p class="text-gray-600 leading-relaxed mb-3"><strong class="text-[#3B2C5B]">Estruturação e Produção:</strong> Estruturação do núcleo; Produção de roteiros, storyboards, animações 2D/3D com softwares livres; Desenho e modelagem dos cenários, ministração de oficinas.</p>
                    <p class="text-gray-600 leading-relaxed mb-3"><strong class="text-[#3B2C5B]">Eventos e Visitas:</strong> Participação na FECINTEC 2019; Visita Técnica para Bodoquena-MS e São Paulo; Visita à Exposição do Leonardo da Vinci no MIS.</p>
                    <div class="award-badge">
                        <svg class="w-4 h-4 text-yellow-600" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        1&ordm; Lugar FETEC 2019
                    </div>
                </div>
            </div>

            <div class="timeline-item timeline-left">
                <div class="timeline-dot">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="timeline-card">
                    <span class="timeline-year">2020</span>
                    <p class="text-gray-600 leading-relaxed mb-3"><strong class="text-[#3B2C5B]">Crescimento:</strong> O NuAR segmenta-se em 4 grupos (Jaguars, Zoinho, Melbourne e o Ctrl+Femme). Desenvolvimento de produções em animação 2D, 3D e roteiros.</p>
                    <p class="text-gray-600 leading-relaxed mb-3"><strong class="text-[#3B2C5B]">Eventos:</strong> Participação na FECINTEC 2020.</p>
                    <div class="award-badge">
                        <svg class="w-4 h-4 text-yellow-600" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        1&ordm; Lugar Linguística/Artes FETEC 2020 &bull; 4&ordm; Lugar Geral MOSTRATEC 2020
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ===== INFORMAÇÕES INSTITUCIONAIS ===== -->
<section id="institucional" class="bg-white py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-5xl">
        <div class="text-center mb-16">
            <span class="section-label">Institucional</span>
            <h2 class="section-title">Informações Institucionais</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="institutional-card">
                <div class="institutional-card-icon">
                    <svg class="h-8 w-8" viewBox="0 0 20 20" fill="currentColor"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/></svg>
