 <%- include('header.ejs') %>


<section id="projetos" class="bg-white py-24 md:py-40 px-4 animate-on-scroll">

    <div class="container mx-auto max-w-7xl">

        <h2 class="text-4xl md:text-5xl font-bold text-[#3B2C5B] text-center mb-16">Nossos Projetos Inovadores</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            <% projetos.forEach(projeto => { %>

            <div class="bg-white card-style p-8 flex flex-col items-center text-center">

                <img src="<%= projeto.imagem_url %>" alt="Imagem do Projeto" loading="lazy" class="w-full rounded-xl shadow-lg mb-6">

                <h3 class="text-2xl font-bold text-[#3B2C5B] mb-3"><%= projeto.titulo %></h3>

                <p class="text-lg text-gray-700 leading-relaxed"><%= projeto.descricao %></p>

            </div>

            <% }) %>

        </div>

    </div>

</section>


<%- include('footer.ejs') %> 