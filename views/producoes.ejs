<%- include('header.ejs') %>

<section id="producoes" class="bg-[#f8f4ff] py-20 md:py-32 px-4 animate-on-scroll">
    <div class="container mx-auto max-w-7xl">
        <div class="text-center mb-16">
            <span class="section-label">Criações do NuAR</span>
            <h2 class="section-title">Produções</h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto mt-4">Animações, roteiros e conteúdos audiovisuais produzidos pelo nosso núcleo.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <% producoes.forEach(producao => { %>
            <article class="producao-card group">
                <div class="producao-card-image">
                    <% if (producao.imagem_url) { %>
                        <img src="<%= producao.imagem_url %>"
                             alt="<%= producao.titulo %>"
                             loading="lazy"
                             class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-105">
                    <% } else { %>
                        <div class="w-full h-52 bg-gradient-to-br from-[#3B2C5B] to-[#C46ED8] flex items-center justify-center">
                            <svg class="h-16 w-16 text-white opacity-40" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm3 2h6v4H7V5zm8 8v2h1v-2h-1zm-2-2H7v4h6v-4zm2 0h1V9h-1v2zm1-4V5h-1v2h1zM5 5H4v2h1V5zM4 9H3v2h1V9zm0 4H3v2h1v-2z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                    <% } %>
                </div>
                <div class="producao-card-body">
                    <% if (producao.projeto_titulo) { %>
                        <span class="producao-project-tag"><%= producao.projeto_titulo %></span>
                    <% } %>
                    <h3 class="text-lg font-bold text-[#3B2C5B] mb-2 leading-tight group-hover:text-[#C46ED8] transition-colors">
                        <%= producao.titulo %>
                    </h3>
                    <% if (producao.descricao) { %>
                        <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">
                            <%= producao.descricao %>
                        </p>
                    <% } %>
                    <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
                        <% if (producao.data_publicacao) { %>
                            <time class="text-xs text-gray-400 font-medium">
                                <%= new Date(producao.data_publicacao).toLocaleDateString("pt-BR", { year: "numeric", month: "short" }) %>
                            </time>
                        <% } %>
                        <% if (producao.link_externo) { %>
                            <a href="<%= producao.link_externo %>" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-1 text-sm font-semibold text-[#C46ED8] hover:text-[#8C40B8] transition-colors">
                                Acessar
                                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </a>
                        <% } %>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>

        <% if (!producoes || producoes.length === 0) { %>
            <div class="text-center py-20">
                <p class="text-gray-400 text-lg">Nenhuma produção cadastrada ainda.</p>
            </div>
        <% } %>
    </div>
</section>

<%- include('footer.ejs') %>
